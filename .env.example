# Copy to .env.local and fill in. .env.local is gitignored.

# --- SMTP (contact forms + portal magic-link sign-in) ---
# Dev: use Ethereal (https://ethereal.email) or Mailtrap (https://mailtrap.io).
# Prod: Joey's SMTP provider, or Resend (free tier: 3k/mo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Inbox that receives contact-form submissions. Defaults to joey@radiantsoundwny.com if unset.
CONTACT_FORM_TO=joey@radiantsoundwny.com

# Optional: From: header for contact-form emails. Defaults to SMTP_USER.
CONTACT_FORM_FROM=

# Optional: separate From: header for portal sign-in magic-link emails.
# Defaults to CONTACT_FORM_FROM, which defaults to SMTP_USER.
AUTH_EMAIL_FROM=

# --- Portal (Phase 2) ---
# SQLite database file.
#
# Gotcha: relative paths in a Prisma SQLite DATABASE_URL are resolved
# RELATIVE TO THE schema.prisma FILE'S DIRECTORY, not the project root.
# Our schema lives at prisma/schema.prisma, so `../data/radiant.db`
# means project_root/data/radiant.db. In Docker the schema is at
# /app/prisma/schema.prisma → /app/data/radiant.db, which matches the
# volume mount declared in docker-compose.yml.
DATABASE_URL="file:../data/radiant.db"

# Auth.js requires a 32+ byte secret for signing session JWTs and email tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL Auth.js uses to build magic links. In dev:
# http://localhost:3000. In prod: https://radiantsoundwny.com.
AUTH_URL=http://localhost:3000

# Comma-separated list of email addresses auto-promoted to ADMIN role
# on first sign-in to the portal. Admins are also always allowed
# through the invite-only allowlist (they can bootstrap themselves).
# All other emails must be invited via /portal/admin before they can
# sign in.
ADMIN_EMAILS=joey@radiantsoundwny.com
