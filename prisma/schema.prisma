// Prisma schema for Radiant Sound client portal (Phase 2).
//
// Datasource: SQLite. The database is a single file on disk
// (data/radiant.db), persisted across deploys via the docker volume
// declared in docker-compose.yml.
//
// Why SQLite: zero ops, file-based, trivial backups (cp the file),
// no separate database process, no network connection, no managed
// service. Handles our scale (dozens of couples) trivially.
//
// Auth.js v5 requires the User/Account/Session/VerificationToken
// tables. Everything else is Radiant Sound domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------- Auth.js v5 tables (do not rename fields) --------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Radiant Sound additions
  firstName String?
  lastName  String?
  role      String  @default("COUPLE") // "COUPLE" | "ADMIN"

  accounts        Account[]
  sessions        Session[]
  projectMembers  ProjectMember[]
  invitedProjects Project[]       @relation("ProjectInvitedBy")
  uploadedFiles   ProjectFile[]   @relation("ProjectFileUploadedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------- Radiant Sound domain --------

/// One wedding. Members (couple) get scoped access via ProjectMember.
model Project {
  id         String    @id @default(cuid())
  title      String // e.g. "Teagan & Isaac"
  eventDate  DateTime?
  venueName  String?
  venueCity  String?
  guestCount Int?
  status     String    @default("LEAD") // "LEAD" | "BOOKED" | "PLANNING" | "COMPLETED" | "CANCELED"
  /// When set, the wedding is archived: hidden from the active admin
  /// list and its couple members lose portal access. Admins still
  /// reach it via /portal/admin/archive. Null = active.
  archivedAt DateTime?

  invitedById String?
  invitedBy   User?   @relation("ProjectInvitedBy", fields: [invitedById], references: [id])

  members         ProjectMember[]
  details         WeddingDetails?
  partyMembers    WeddingPartyMember[]
  announcements   EventAnnouncement[]
  playlistSongs   PlaylistSong[]
  ceremonyMusic   CeremonyMusicEntry[]
  lineDances      LineDance[]
  itineraryItems  ItineraryItem[]
  files           ProjectFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------- Planning sheet (Phase 2C) — modeled on Joey's --------
// _assetdump/MASTER Wedding Planner Form .xlsx, six tabs:
//   General Info, Wedding Party Info, Events and Music Requests,
//   Ceremony, Line Dances, Itinerary.

/// 1:1 with Project — every field across the spreadsheet that's a
/// single value (not a repeating row). Includes the question
/// answers from the Wedding Party + Events + Ceremony tabs.
model WeddingDetails {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // General Info tab
  weddingDate           DateTime?
  contactPhone          String?
  contactEmail          String?
  brideFirstName        String?
  brideLastName         String?
  groomFirstName        String?
  groomLastName         String?
  receptionVenueName    String?
  receptionVenueAddress String?
  ceremonyVenueName     String?
  ceremonyVenueAddress  String?
  venueManagerName      String?
  venueManagerPhone     String?
  venueManagerEmail     String?
  photographerName      String?
  photographerEmail     String?
  videographerName      String?
  videographerEmail     String?
  guestCount            Int?
  earliestArrival       String? // free-text time, e.g. "4:00 PM"
  djArrival             String?
  linenColor            String? // "BLACK" | "WHITE"
  generalNotes          String?

  // Wedding Party question
  announceWeddingParty Boolean?

  // Events & Music Requests questions
  takeAudienceRequests Boolean?
  cocktailGenre        String?
  receptionGenres      String?
  announceLastCall     Boolean?
  announceShuttle      Boolean?
  shuttleTimes         String? // free-text — shown when announceShuttle is yes
  coupleAnnouncement   String?
  miscDetails          String?

  // Ceremony questions
  ceremonyWalkOutOrder String?
  ceremonyWirelessMic  Boolean?
  ceremonyOutdoors     Boolean?
  ceremonyOtherDetails String?

  updatedAt DateTime @updatedAt
}

/// Wedding Party tab — one row per bridesmaid/groomsman pair.
model WeddingPartyMember {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bridesmaidName String?
  groomsmanName  String?
  title          String? // "Maid of Honor", "Ring Bearer", etc.
  songName       String?
  songArtist     String?
  notes          String?
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Events tab — DJ-announced moments with the people involved + song.
/// Default events seeded on first visit: First Dance, Mother/Son,
/// Father/Daughter, Cake Cutting, Bouquet Toss, Garter Toss. Couples
/// can also add custom events.
model EventAnnouncement {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Stable key for the default events ("FIRST_DANCE", "MOTHER_SON",
  /// "FATHER_DAUGHTER", "CAKE", "BOUQUET", "GARTER") or "CUSTOM".
  eventKey       String  @default("CUSTOM")
  /// Used when eventKey === "CUSTOM" (overrides the default label).
  customTitle    String?
  /// Names of the people in this moment (e.g. mother + son's names).
  peopleInvolved String?
  songName       String?
  songArtist     String?
  notes          String?
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One song in one of the user-maintained playlists from the
/// Events & Music Requests tab.
model PlaylistSong {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Which list: "COCKTAIL_DINNER" | "RECEPTION_PLAYLIST" | "DO_NOT_PLAY"
  listType   String
  songName   String
  songArtist String?
  notes      String?
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ceremony tab music segments. Default segments: PRE_CEREMONY,
/// PROCESSIONAL, BRIDAL_ENTRY, RECESSIONAL.
model CeremonyMusicEntry {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "PRE_CEREMONY" | "PROCESSIONAL" | "BRIDAL_ENTRY" | "RECESSIONAL" | "CUSTOM"
  segment     String  @default("CUSTOM")
  customLabel String?
  songName    String?
  songArtist  String?
  notes       String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Line Dances tab. Seeded with the 14 standard line dances from the
/// spreadsheet on first visit; couples can toggle `wanted` and add
/// custom entries.
model LineDance {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  wanted    Boolean @default(false)
  /// Distinguish the pre-seeded defaults from couple-added ones.
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Itinerary tab. Seeded with 30 half-hour slots from 9 AM to 12 AM
/// on first visit; couples fill in `event` and `notes`. Time string
/// is free-text so couples can add custom slots between defaults.
model ItineraryItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  time      String
  event     String?
  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-project uploaded files (Phase 2D). Contracts, vendor docs,
/// invoices, photos, song lists. Bytes live on the VPS disk under
/// `data/uploads/<projectId>/<storageKey>`; this row holds the
/// metadata + access control.
model ProjectFile {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("ProjectFileUploadedBy", fields: [uploadedById], references: [id])

  /// Filename on disk — cuid + extension. Never exposes the original
  /// name in the URL; the user-facing name lives in `name`.
  storageKey String @unique
  /// Original filename for display + Content-Disposition.
  name       String
  mimeType   String
  sizeBytes  Int

  createdAt DateTime @default(now())
}

/// Many-to-many between Users and Projects. A wedding can have
/// multiple logins (bride, groom, planner) — every member sees the
/// same Project.
model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String @default("OWNER") // "OWNER" | "COLLABORATOR"

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}
