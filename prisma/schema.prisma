// Prisma schema for Radiant Sound client portal (Phase 2).
//
// Datasource: SQLite. The database is a single file on disk
// (data/radiant.db), persisted across deploys via the docker volume
// declared in docker-compose.yml.
//
// Why SQLite: zero ops, file-based, trivial backups (cp the file),
// no separate database process, no network connection, no managed
// service. Handles our scale (dozens of couples) trivially.
//
// Auth.js v5 requires the User/Account/Session/VerificationToken
// tables. Everything else is Radiant Sound domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------- Auth.js v5 tables (do not rename fields) --------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Radiant Sound additions
  firstName String?
  lastName  String?
  role      String  @default("COUPLE") // "COUPLE" | "ADMIN"

  accounts        Account[]
  sessions        Session[]
  projectMembers  ProjectMember[]
  invitedProjects Project[]       @relation("ProjectInvitedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------- Radiant Sound domain --------

/// One wedding. Members (couple) get scoped access via ProjectMember.
model Project {
  id         String    @id @default(cuid())
  title      String // e.g. "Teagan & Isaac"
  eventDate  DateTime?
  venueName  String?
  venueCity  String?
  guestCount Int?
  status     String    @default("LEAD") // "LEAD" | "BOOKED" | "PLANNING" | "COMPLETED" | "CANCELED"

  invitedById String?
  invitedBy   User?   @relation("ProjectInvitedBy", fields: [invitedById], references: [id])

  members         ProjectMember[]
  timeline        TimelineEvent[]
  music           MusicSelection[]
  vendors         VendorContact[]
  equipmentNotes  EquipmentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single line on the day-of timeline (Phase 2C).
/// E.g. { time: "5:30 PM", title: "First dance", notes: "Song: …" }.
model TimelineEvent {
  id        String  @id @default(cuid())
  projectId String
  time      String? // free-text — "5:30 PM", "TBD", a window, etc.
  title     String
  notes     String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A song request or do-not-play (Phase 2C).
model MusicSelection {
  id        String  @id @default(cuid())
  projectId String
  /// Bucket — string-enum: "PROCESSIONAL" | "RECESSIONAL" | "FIRST_DANCE"
  /// | "PARENT_DANCE" | "MUST_PLAY" | "DO_NOT_PLAY" | "OTHER"
  category  String  @default("OTHER")
  title     String
  artist    String?
  notes     String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One vendor working the wedding alongside us (Phase 2C).
model VendorContact {
  id        String  @id @default(cuid())
  projectId String
  /// Role — string-enum: "PHOTOGRAPHER" | "VIDEOGRAPHER" | "PLANNER"
  /// | "VENUE_COORDINATOR" | "OFFICIANT" | "CATERER" | "FLORIST" | "OTHER"
  role      String  @default("OTHER")
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Free-form logistics note (Phase 2C). Used for power, load-in,
/// ceremony-vs-reception, weather plan, etc.
model EquipmentNote {
  id        String  @id @default(cuid())
  projectId String
  /// Category — string-enum: "POWER" | "LOAD_IN" | "CEREMONY_LOCATION"
  /// | "RECEPTION_LOCATION" | "WEATHER_PLAN" | "OTHER"
  category  String  @default("OTHER")
  body      String
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Many-to-many between Users and Projects. A wedding can have
/// multiple logins (bride, groom, planner) — every member sees the
/// same Project.
model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String @default("OWNER") // "OWNER" | "COLLABORATOR"

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}
